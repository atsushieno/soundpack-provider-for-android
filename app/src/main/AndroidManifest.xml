<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:label="Soundpack Manager">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Share with Soundpack Manager" from an app's own folder list
             (FolderRegistry.shareWithHubIntent()). -->
        <activity
            android:name=".ShareFolderActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="org.androidaudioplugin.soundpack.action.SHARE_FOLDER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- One provider per kind (docs/PLAN.md §3.2), discoverable by its action. Like a pack
             app's provider, every app can read it: sharing a folder here publishes it to every
             soundpack app. -->
        <provider
            android:name="org.androidaudioplugin.soundpack.host.SfzFolderProvider"
            android:authorities="${applicationId}.soundpack.sfz"
            android:exported="true">
            <intent-filter>
                <action android:name="org.androidaudioplugin.soundpack.sfz.V1" />
            </intent-filter>
        </provider>
        <provider
            android:name="org.androidaudioplugin.soundpack.host.Sf2FolderProvider"
            android:authorities="${applicationId}.soundpack.sf2"
            android:exported="true">
            <intent-filter>
                <action android:name="org.androidaudioplugin.soundpack.sf2.V1" />
            </intent-filter>
        </provider>
        <provider
            android:name="org.androidaudioplugin.soundpack.host.JsfxFolderProvider"
            android:authorities="${applicationId}.soundpack.jsfx"
            android:exported="true">
            <intent-filter>
                <action android:name="org.androidaudioplugin.soundpack.jsfx.V1" />
            </intent-filter>
        </provider>
        <provider
            android:name="org.androidaudioplugin.soundpack.host.HostSampleFolderProvider"
            android:authorities="${applicationId}.soundpack.hostsample"
            android:exported="true">
            <intent-filter>
                <action android:name="org.androidaudioplugin.soundpack.hostsample.V1" />
            </intent-filter>
        </provider>
        <!-- The resource types the user adds in the Types tab, all through one provider: a type
             defined at run time cannot declare one of its own. -->
        <provider
            android:name="org.androidaudioplugin.soundpack.host.TypesFolderProvider"
            android:authorities="${applicationId}.soundpack.types"
            android:exported="true">
            <intent-filter>
                <action android:name="org.androidaudioplugin.soundpack.types.V1" />
            </intent-filter>
        </provider>
    </application>
</manifest>
